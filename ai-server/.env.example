# WeStudy AI Server Environment Configuration Template
# Copy this file to '.env' and fill in your keys.

# OpenAI API Key (Optional, used for RAG generation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Optional alternative)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Embedding Model Name (Defaults to ko-sroberta-multitask)
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask
